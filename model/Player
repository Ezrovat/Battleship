import {Gameboard} from "./Gameboard.js";


class Player {
    constructor(name, strategy=null) {
        this.name = name;
        this.#gameboard = new Gameboard();
        this.#strategy = strategy;
    }

    get gameboard() {
        return this.#gameboard;
    }

    setStrategy(strategy) {
        this.#strategy = strategy;
    }
    

}
